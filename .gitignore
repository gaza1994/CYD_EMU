target/
# the Atech firmware moved to github.com/joakimeriksson/atech-firmware; an existing
# checkout keeps a local build tree here, which is no longer this repo's
/boards/
*.log
!docs/evidence/**/*.log
*.wav
*.png
!web/assets/*
hw/*.bin
hw/*.dump
hw/*trace*.txt
examples/hello_world/build/
examples/hello_world-c3/build/
examples/hello_world-c3/sdkconfig*
examples/hello_world-c3/managed_components/
examples/hello_world-c6/build/
examples/hello_world-c6/sdkconfig*
examples/hello_world-c6/managed_components/
examples/hello_world/sdkconfig*
examples/hello_world/managed_components/
examples/wifi-station/build/
*.actual
__pycache__/
.DS_Store
web/wasm/esp32sim.wasm

# fetched by tools/fetch-web-vendor.sh (xterm.js for the Terminal tab), not committed
web/vendor/

examples/hello_world-classic/.pio/
examples/hello_world-classic/sdkconfig*
!examples/hello_world-classic/sdkconfig.defaults

# --- CYD_EMU monorepo ---
# release zips and scratch output (the zips are built by .github/workflows/release.yml)
/release/
/cyd-lab/release/
*.zip
.dbg/
scratch/
# mask ROM ELFs fetched by tools/fetch-rom-elfs.sh (Apache-2.0, downloaded, not committed)
/roms/
# cyd-lab's own build tree and ESPHome cache (target/ above already matches it)
/cyd-lab/firmware/esphome-ha/.esphome/
# the root ignores *.png; cyd-lab's documentation screenshots and assets are committed
!/cyd-lab/**/*.png
